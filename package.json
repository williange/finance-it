  "dependencies": {
    "@prisma/composer": "0.16.0",
    "@prisma/composer-prisma-cloud": "0.16.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "8.0.0-rc.12",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
